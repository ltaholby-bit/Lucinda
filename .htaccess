# Force ONE canonical hostname (non-www, HTTPS) so Google indexes a single
# address. Must match the <link rel="canonical"> tags in the HTML.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> non-www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # http -> https
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
